# Chỉ đẩy tài liệu + code. Mặc định bỏ qua mọi file, rồi cho phép từng loại.
*
!*/

# --- Tài liệu ---
!*.md
!*.txt

# --- Code ---
!*.cs
!*.py
!*.js
!*.html
!*.shader
!*.cginc
!*.hlsl
!*.compute
!*.shadergraph
!*.shadersubgraph
!*.asmdef
!*.json
!*.ps1

# Bảng tra Library (tên cũ / nguồn của từng texture): thông tin, không phải tài nguyên
!/Docs/VFX/_Library/*.csv

# .meta của code (giữ GUID cho Unity)
!*.cs.meta
!*.shader.meta
!*.cginc.meta
!*.hlsl.meta
!*.compute.meta
!*.shadergraph.meta
!*.shadersubgraph.meta
!*.asmdef.meta

# File cấu hình gốc
!/.gitignore
!/.vsconfig
!/.mcp.json
!/.worktreeinclude
!/.env.example
!.gitkeep

# --- Luôn bỏ qua (thư mục sinh tự động, cấu hình cá nhân) ---
Library/
Temp/
Logs/
obj/
Build/
Builds/
.vs/
UserSettings/
__pycache__/
*.csproj
*.sln
.claude/settings.local.json
CLAUDE.local.md
.env
.env.*
!/.env.example
# Trang Review Lab sinh ra (1 file lớn tự chứa ảnh)
/Docs/VFX/_Review/
